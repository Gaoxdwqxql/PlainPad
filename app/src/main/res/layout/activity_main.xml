<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- 顶部状态栏填充 -->
        <View
            android:id="@+id/statusBarFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary" />

        <!-- 顶栏 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_undo"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_undo"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_redo"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_redo"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnFind"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_find"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_save"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_save"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_settings"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_more"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- 标签栏 -->
        <HorizontalScrollView
            android:id="@+id/tabScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- 内嵌查找栏 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/findBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 第一行：输入框（内含计数）+ 导航 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_search_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_search"
                            android:contentDescription="@null"
                            app:tint="?android:attr/textColorSecondary" />

                        <EditText
                            android:id="@+id/etFindInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:hint="@string/find_hint"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingVertical="0dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?android:attr/textColorSecondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFindCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnFindPrev"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="2dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_up"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/find_prev"
                        app:tint="?attr/colorPrimary" />

                    <ImageButton
                        android:id="@+id/btnFindNext"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_down"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/find_next"
                        app:tint="?attr/colorPrimary" />

                    <ImageButton
                        android:id="@+id/btnFindClose"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_close"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>

                <!-- 第二行：选项，自动换行，不需要横向滑动 -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/findChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cbFindRegex"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_regex"
                        android:textSize="12sp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cbFindCase"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_case_sensitive"
                        android:textSize="12sp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/cbFindFromStart"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_from_start"
                        android:textSize="12sp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btnToggleReplace"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/replace"
                        android:textSize="12sp"
                        app:ensureMinTouchTargetSize="false" />
                </com.google.android.material.chip.ChipGroup>

                <!-- 仅当「正则表达式」开启时出现，用白话解释这个选项 -->
                <TextView
                    android:id="@+id/tvSearchHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/search_regex_hint"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- 第三行：替换（仅替换模式显示） -->
                <LinearLayout
                    android:id="@+id/findReplaceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etReplaceInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search_pill"
                        android:hint="@string/replace_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="14dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplaceCurrent"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="@string/replace"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplaceAllInBar"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/replace_all"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 编辑区 -->
        <FrameLayout
            android:id="@+id/editArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingEnd="18dp">

                <com.sunwenqing.plainpad.LineNumberView
                    android:id="@+id/tvLineNumbers"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="30dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:visibility="gone" />

                <com.sunwenqing.plainpad.PlainEditText
                    android:id="@+id/editor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:hint="@string/editor_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="16dp"
                    android:saveEnabled="false"
                    android:scrollbars="none"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.0"
                    android:textAppearance="@style/TextAppearance.PlainPad.Editor"
                    tools:ignore="LabelFor" />

                <com.sunwenqing.plainpad.LargeTextView
                    android:id="@+id/largeTextView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:padding="16dp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.sunwenqing.plainpad.FastScrollBarView
                android:id="@+id/fastScrollBar"
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="2dp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- 底部状态栏 -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="0 字符 · 1 行" />

            <TextView
                android:id="@+id/tvEncoding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:background="?attr/colorSurfaceVariant"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="UTF-8" />

            <TextView
                android:id="@+id/tvEol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:background="?attr/colorSurfaceVariant"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="LF" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="7dp"
                android:src="@drawable/ic_bookmark"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_bookmarks"
                app:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/btnInsertSpecial"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:padding="6dp"
                android:src="@drawable/ic_insert_special"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/insert_special_cd"
                app:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- 底部导航栏填充 -->
        <View
            android:id="@+id/navigationBarFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/colorPrimary" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExitImmersive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:visibility="gone"
        android:alpha="0.85"
        android:text="@string/exit_immersive"
        app:cornerRadius="24dp"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="100dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/tvLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
