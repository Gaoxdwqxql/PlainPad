    <!-- ========== 帮助菜单 ========== -->
    <string name="menu_help">帮助</string>
    <string name="help_title">帮助</string>
    <string name="help_intro">PlainPad 是一个轻量、纯粹、离线的纯文本编辑器。以下是各项功能的说明。点击左上角返回箭头或按返回键退出。</string>

    <!-- 文件操作 -->
    <string name="help_section_file">文件操作</string>
    <string name="help_file_content">• 新建：菜单 → 新建，或标签栏末尾的 + 号\n• 打开：菜单 → 打开…，通过系统文件选择器选择 txt 文件\n• 保存：点击顶栏保存图标 → 保存当前\n• 全部保存：一次性保存所有已命名且被修改的标签，未命名文件会跳过\n• 另存为：选择保存编码后再选择保存位置\n• 关闭标签：点击标签上的 × 号，或菜单 → 关闭当前标签\n• 最近文件：菜单 → 最近文件，可快速打开最近 10 个文件\n• 设为默认：菜单 → 设为默认文本编辑器，跳转到系统设置页</string>

    <!-- 编辑功能 -->
    <string name="help_section_edit">编辑功能</string>
    <string name="help_edit_content">• 撤销 / 重做：顶栏左右箭头图标，最多 100 步，连续输入合并为一步\n• 查找：顶栏放大镜图标，支持向上 / 向下查找\n• 替换：菜单 → 替换，支持单个替换与全部替换\n• 跳转到行：菜单 → 跳转到行，输入行号即可定位\n• 插入特殊字符：底栏最右的 ⊕ 图标，可插入换行、制表符、零宽字符、不换行空格等\n• 统计信息：点击底栏左下角的状态文字，弹出详细统计</string>

    <!-- 统计信息 -->
    <string name="help_section_stats">统计信息</string>
    <string name="help_stats_content">点击底栏左下角的状态文字，弹出详细统计：\n• 字符数（含 / 不含空格）\n• 可见 / 不可见字符\n• 英文字母、数字、中文字符数\n• 词数、总行数、非空行数、段落数\n• 最长行（按半角宽计算）\n\n可在设置 → 编辑体验 中勾选底栏默认显示哪 2 项指标。</string>

    <!-- 标签页 -->
    <string name="help_section_tabs">标签页</string>
    <string name="help_tabs_content">• 新建标签：点击标签栏末尾的 + 号，或菜单 → 新建\n• 切换标签：点击对应标签，切换时自动保存光标、滚动位置\n• 关闭标签：点击标签上的 × 号；若有未保存修改会询问\n• 加号行为：可在设置中选"优先切换已有空标签"或"总是新建"\n• 启动模式：可在设置中配置冷启动时是恢复标签、新建并丢弃历史、还是新建并保留历史</string>

    <!-- 外观设置 -->
    <string name="help_section_appearance">外观设置</string>
    <string name="help_appearance_content">• 字体大小：设置 → 字体大小，10 ~ 40 sp\n• 编辑区主题：跟随应用主题、纯白、米黄护眼、淡绿护眼、纯黑 OLED、深灰、午夜蓝\n• 编辑区字体：等宽、无衬线、衬线\n• 显示行号：行号栏宽度固定，不随字号变化，数字与文本严格对齐\n• 自动换行：设置 → 自动换行\n• 应用主题：跟随系统 / 浅色 / 深色</string>

    <!-- 手势与操作 -->
    <string name="help_section_gesture">手势与操作</string>
    <string name="help_gesture_content">• 双指缩放：在编辑区用两根手指张开 / 收拢，实时调整字号\n• 右侧滚动条：手指按住拖动可快速定位，松手后有惯性滑动；条的颜色跟随文字颜色\n• 长按选中：与系统一致，可选中文字、复制、粘贴\n• 标签栏滑动：标签过多时可左右滑动浏览</string>

    <!-- 自动保存 -->
    <string name="help_section_autosave">自动保存</string>
    <string name="help_autosave_content">在设置 → 保存 中开启自动保存后，可选以下触发方式：\n• 切到后台时保存\n• 切换标签时保存\n• 内容变化时保存：停止输入约 2 秒后自动写盘（防抖）\n• 定时保存：可设置 15 秒 ~ 10 分钟的间隔\n\n注意：只有"已命名过"（已有文件路径）的标签才会被自动保存；未命名标签会跳过。底栏会显示"上一次自动保存于 HH:MM"。</string>

    <!-- 编码支持 -->
    <string name="help_section_encoding">编码支持</string>
    <string name="help_encoding_content">打开文件时自动识别 BOM 并优先按 UTF-8 解码，失败时回退 GBK，避免中文乱码。\n保存时可选择：UTF-8、UTF-16LE、UTF-16BE、GBK、GB2312。\n底栏右侧会显示当前文件的编码。</string>

    <!-- 沉浸阅读 -->
    <string name="help_section_immersive">沉浸阅读</string>
    <string name="help_immersive_content">菜单 → 沉浸阅读，隐藏顶栏、标签栏、状态栏与系统状态栏，只留纯文本。\n右下角会出现"退出阅读"按钮，按返回键也能退出。</string>

    <!-- ========== 新手引导 ========== -->
    <string name="onboard_skip">跳过</string>
    <string name="onboard_next">下一步</string>
    <string name="onboard_start">开始使用</string>

    <string name="onboard_welcome_title">欢迎使用 PlainPad</string>
    <string name="onboard_welcome_desc">一个轻量、纯粹、离线的纯文本编辑器。\n\n没有广告、没有账号、没有云同步，所有内容都保存在你的设备上。</string>

    <string name="onboard_tabs_title">多标签编辑</string>
    <string name="onboard_tabs_desc">点标签栏末尾的 + 号即可新建标签。\n\n切换标签会自动保留光标和滚动位置。标签栏可左右滑动浏览。\n\n点击标签上的 × 号即可关闭。</string>

    <string name="onboard_save_title">保存与自动保存</string>
    <string name="onboard_save_desc">顶栏的保存按钮可以"全部保存"、"保存当前"或"另存为"。\n\n开启自动保存后，可以在切到后台、切换标签、内容变化（停止输入 2 秒）、或定时等条件下自动写盘。</string>

    <string name="onboard_prev">上一步</string>
    <string name="auto_save_never">尚未保存</string>
    <string name="onboard_find_title">查找、替换、跳转</string>
    <string name="onboard_find_desc">顶栏的放大镜图标用于查找。\n\n更多菜单里有替换与跳转到行。\n\n查找支持向上 / 向下，替换支持单个替换与全部替换。</string>

    <string name="onboard_appearance_title">个性化外观</string>
    <string name="onboard_appearance_desc">设置里可以调整字号、字体、应用主题。\n\n编辑区主题提供：纯白、米黄护眼、淡绿护眼、纯黑 OLED、深灰、午夜蓝。\n\n行号栏宽度固定，不随字号缩放而跳动。</string>

    <string name="onboard_gesture_title">手势操作</string>
    <string name="onboard_gesture_desc">编辑区双指张开 / 收拢可实时调整字号。\n\n右侧滚动条比系统自带的更宽更好抓，拖动时松手会有惯性滑动。\n\n点击左下角的状态文字可弹出详细统计。</string>

    <string name="onboard_special_title">插入特殊字符</string>
    <string name="onboard_special_desc">底栏右侧的 ⊕ 图标可以快速插入：\n\n换行 LF、回车 CR、制表符 TAB、零宽空格、不换行空格、全角空格、BOM 等不可见字符。</string>

    <string name="onboard_done_title">开始使用</string>
    <string name="onboard_done_desc">所有功能都可以随时通过"菜单 → 帮助"重新查看。\n\n现在，点击下方按钮开始吧！</string>

    <!-- 关于 -->


    <!-- 特殊字符面板 -->
    <string name="special_chars_title">特殊字符</string>
    <string name="special_chars_show">显示特殊字符</string>
