    <string name="onboard_welcome_title">Welcome to PlainPad</string>
    <string name="onboard_welcome_desc">A lightweight, pure, offline plain text editor.\n\nNo ads, no account, no cloud sync. All data stays on your device.</string>

    <string name="onboard_tabs_title">Multi-Tab Editing</string>
    <string name="onboard_tabs_desc">Tap + at the end of tab bar to create a new tab.\n\nCursor and scroll position are saved when switching tabs.\n\nTap × to close.</string>

    <string name="onboard_save_title">Saving &amp; Auto Save</string>
    <string name="onboard_save_desc">The save button supports Save All, Save Current, and Save As.\n\nEnable Auto Save to write to disk on background, tab switch, typing stop (2s), or interval.</string>

    <string name="onboard_prev">Previous</string>
    <string name="auto_save_never">Not saved yet</string>
    <string name="onboard_find_title">Find, Replace, Go to Line</string>
    <string name="onboard_find_desc">Tap the magnifier to find.\n\nMore menu contains Replace and Go to Line.\n\nSearch supports up/down.</string>

    <string name="onboard_appearance_title">Personalize</string>
    <string name="onboard_appearance_desc">Adjust font size, font family, and themes in settings.\n\nEditor themes: White, Sepia, Green, OLED, Dark Gray, Midnight Blue.\n\nLine number width is fixed and doesn\'t jump with font size.</string>

    <string name="onboard_gesture_title">Gestures</string>
    <string name="onboard_gesture_desc">Pinch to zoom in the editor.\n\nThe custom scrollbar is thicker and easier to grab, with inertia.\n\nTap the status text to see statistics.</string>

    <string name="onboard_special_title">Insert Special Chars</string>
    <string name="onboard_special_desc">Use the ⊕ icon in the status bar to insert:\n\nLF, CR, TAB, Zero Width Space, Non-breaking Space, Full-width Space, BOM, etc.</string>

    <string name="onboard_done_title">Get Started</string>
    <string name="onboard_done_desc">All features can be viewed anytime in Menu → Help.\n\nClick the button below to start now!</string>

