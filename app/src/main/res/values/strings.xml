    <!-- Help -->
    <string name="menu_help">Help</string>
    <string name="help_title">Help</string>
    <string name="help_intro">PlainPad is a lightweight, pure, offline plain text editor. Below is the guide for all features. Tap the back arrow or press Back to exit.</string>

    <string name="help_section_file">File Operations</string>
    <string name="help_file_content">• New: Menu → New, or the + at the end of tab bar\n• Open: Menu → Open… via system file picker\n• Save: Top bar save icon → Save Current\n• Save All: Save all named and modified tabs\n• Save As: Choose encoding then save location\n• Close Tab: Tap × on the tab, or Menu → Close Tab\n• Recent Files: Menu → Recent Files (last 10)\n• Set Default: Menu → Set as Default Editor</string>

    <string name="help_section_edit">Editing</string>
    <string name="help_edit_content">• Undo / Redo: Top bar arrows, up to 100 steps\n• Find: Top bar magnifier, supports up/down\n• Replace: Menu → Replace, one or all\n• Go to Line: Menu → Go to Line\n• Insert Special Char: ⊕ in status bar\n• Show Special Chars: Enable in settings\n• Statistics: Tap the status text in bottom-left</string>

    <string name="help_section_stats">Statistics</string>
    <string name="help_stats_content">Tap the status text to pop up statistics:\n• Chars (with / without space)\n• Visible / Invisible chars\n• Letters, digits, Chinese chars\n• Words, total/non-empty lines, paragraphs\n• Max line width\n\nYou can choose which 2 items to show in Settings → Editing.</string>

    <string name="help_section_tabs">Tabs</string>
    <string name="help_tabs_content">• New Tab: Tap + or Menu → New\n• Switch Tab: Tap tab, cursor/scroll is auto-saved\n• Close Tab: Tap ×, unsaved changes will prompt\n• Plus Behavior: Reuse empty tab or always new\n• Startup Mode: Restore, new &amp; discard, or new &amp; keep</string>

    <string name="help_section_appearance">Appearance</string>
    <string name="help_appearance_content">• Theme Color: 8 preset colors. Icon switches automatically (Android 12+)\n• Font Size: Settings → Font Size, 10 ~ 40 sp\n• Editor Theme: Follow app, White, Sepia, Green, OLED, Dark Gray, Midnight Blue\n• Editor Font: Monospace, Sans Serif, Serif\n• Show Line Numbers: Width is fixed, strictly aligned\n• Word Wrap: Settings → Word Wrap\n• App Theme: System / Light / Dark</string>

    <string name="help_section_gesture">Gestures</string>
    <string name="help_gesture_content">• Pinch to Zoom: Two fingers in editor area\n• Right Scrollbar: Drag to scroll, has inertia\n• Long Press: Select, copy, paste as system default\n• Tab Scroll: Swipe horizontally when too many tabs</string>

    <string name="help_section_autosave">Auto Save</string>
    <string name="help_autosave_content">Enable in Settings → Saving:\n• Save on background\n• Save on tab switch\n• Save on edit (2s debounce)\n• Interval save (15s ~ 10min)\n\nNote: Only named files are auto-saved. Status bar shows last save time.</string>

    <string name="help_section_encoding">Encoding Support</string>
    <string name="help_encoding_content">Auto-detects BOM and decodes as UTF-8 first, falls back to GBK.\nSave options: UTF-8, UTF-16LE, UTF-16BE, GBK, GB2312.\nCurrent encoding is shown in bottom-right.</string>

    <string name="help_section_eol">End of Line (EOL)</string>
    <string name="help_eol_content">The current EOL format (CRLF or LF) is displayed in the bottom bar next to the encoding.\n• Windows uses CRLF (\\r\\n)\n• Unix / macOS uses LF (\\n)\n\nTap the CRLF or LF label in the bottom bar to convert between them to prevent formatting issues across different operating systems.</string>

    <string name="help_section_large_file">Large File Mode</string>
    <string name="help_large_file_content">To ensure extreme smoothness on mobile devices, PlainPad has special handling for very large texts:\n• Read limit: Up to 20MB. Excess will be truncated with a prompt.\n• Performance protection: When a single file exceeds 3 million chars, or contains an extremely long line over 10,000 chars, it automatically enters "Large File Mode".\n• Restricted features: To prevent lag or OOM (Out of Memory), line numbers, undo/redo, pinch-to-zoom, special char rendering, and statistics are disabled in this mode.</string>

    <string name="help_section_immersive">Immersive Mode</string>
    <string name="help_immersive_content">Menu → Immersive Mode hides all bars. \nExit with the button in bottom-right or press Back.</string>

