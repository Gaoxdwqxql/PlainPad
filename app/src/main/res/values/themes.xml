<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================ -->
    <!--                        应用主主题                              -->
    <!-- ============================================================ -->

    <style name="Theme.PlainPad" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ★ 全局覆盖所有 EditText 的默认样式 -->
        <item name="editTextStyle">@style/Widget.PlainPad.EditText</item>

        <!-- Dialog 统一圆角与描边 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PlainPad.MaterialAlertDialog</item>

    </style>

    <!-- ============================================================ -->
    <!--                    EditText 样式                               -->
    <!-- ============================================================ -->

    <style name="Widget.PlainPad.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textAppearance">@style/TextAppearance.PlainPad.EditText</item>
        <item name="android:textSelectHandle">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleLeft">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleRight">@drawable/ic_select_handle</item>
        <item name="android:textCursorDrawable">@drawable/ic_cursor</item>
    </style>

    <style name="TextAppearance.PlainPad.EditText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSelectHandle">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleLeft">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleRight">@drawable/ic_select_handle</item>
    </style>

    <style name="TextAppearance.PlainPad.Editor" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textSelectHandle">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleLeft">@drawable/ic_select_handle</item>
        <item name="android:textSelectHandleRight">@drawable/ic_select_handle</item>
    </style>

    <!-- ============================================================ -->
    <!--                    Dialog 圆角与描边                           -->
    <!-- ============================================================ -->

    <style name="ThemeOverlay.PlainPad.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PlainPad.Dialog</item>
    </style>

    <style name="ShapeAppearance.PlainPad.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- ============================================================ -->
