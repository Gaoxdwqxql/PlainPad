<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PlainPadApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_purple"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.PlainPad">

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsSearchActivity"
            android:exported="false"
            android:label="@string/settings_search_title"
            android:parentActivityName=".SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FontManagerActivity"
            android:exported="false"
            android:label="@string/font_manager_title"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity" />

        <!-- ★ 开发者选项，只能从关于页连点版本号进入 -->
        <activity
            android:name=".DeveloperOptionsActivity"
            android:exported="false"
            android:label="@string/dev_options_title"
            android:parentActivityName=".AboutActivity" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/help_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/onboard_welcome_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/*" />
                <data android:scheme="file" android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- ==================== 动态图标别名 ==================== -->

        <activity-alias
            android:name=".icon.Purple"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_purple"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Blue"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Indigo"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_indigo"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Teal"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_teal"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Green"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_green"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Orange"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_orange"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Red"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_red"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Pink"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_pink"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>